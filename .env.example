# Anslutning till PostgreSQL.
# Neon: använd den poolade anslutningssträngen (värdnamnet innehåller "-pooler").
# Lokalt: postgres://postgres:postgres@localhost:5432/blindprovat
DATABASE_URL=

# Admininloggning (Auth.js med GitHub).
# AUTH_SECRET krypterar sessionscookien. Generera med: npx auth secret
AUTH_SECRET=
# Skapa en OAuth-app på GitHub (Settings > Developer settings > OAuth Apps).
# Callback-URL lokalt: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
